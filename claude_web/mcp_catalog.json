{
  "version": 3,
  "note": "Built-in connector catalog. transport: stdio|http|sse; auth: none|api_key|oauth. Entries may carry a local brand logo (logo: connectors/<id>.svg, from simple-icons CC0) rendered on a brand-color tile (brand); entries without a logo fall back to the emoji icon. api_key entries declare secret_fields so the UI collects keys and routes them to the encrypted secret store. Verified 2026-08: the @modelcontextprotocol/server-* reference packages were mostly deprecated 2025-05; only filesystem/fetch/memory survive. Commercial services without a public MCP are listed as http templates for the user to fill in.",
  "connectors": [
    {
      "id": "filesystem",
      "name": "Filesystem",
      "category": "dev",
      "transport": "stdio",
      "auth": "none",
      "icon": "📁",
      "description": "读写本地目录文件（限定在允许的路径内）。",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "<允许访问的目录>"],
      "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
    },
    {
      "id": "fetch",
      "name": "Fetch 抓网页",
      "category": "web",
      "transport": "stdio",
      "auth": "none",
      "icon": "🌐",
      "description": "抓取网页并转为适合模型阅读的文本。需已安装 uv（uvx）。",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch"
    },
    {
      "id": "playwright",
      "name": "Playwright 浏览器操作",
      "category": "web",
      "transport": "stdio",
      "auth": "none",
      "icon": "🎭",
      "logo": "connectors/playwright.svg",
      "brand": "#2EAD33",
      "description": "微软官方浏览器自动化：网页导航、点击、填表、抓取。对应“操作浏览器”。",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "docs": "https://github.com/microsoft/playwright-mcp"
    },
    {
      "id": "github",
      "name": "GitHub",
      "category": "dev",
      "transport": "http",
      "auth": "oauth",
      "icon": "🐙",
      "logo": "connectors/github.svg",
      "brand": "#181717",
      "description": "GitHub 官方远程 MCP：仓库、Issue、PR、代码搜索（OAuth 授权）。",
      "url": "https://api.githubcopilot.com/mcp/",
      "docs": "https://github.com/github/github-mcp-server"
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "category": "dev",
      "transport": "stdio",
      "auth": "api_key",
      "icon": "🦊",
      "logo": "connectors/gitlab.svg",
      "brand": "#FC6D26",
      "description": "GitLab 仓库、MR、Issue（社区维护包 @zereight/mcp-gitlab）。",
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "secret_fields": [
        {"target": "env", "key": "GITLAB_PERSONAL_ACCESS_TOKEN", "label": "GitLab Personal Access Token"},
        {"target": "env", "key": "GITLAB_API_URL", "label": "GitLab API 地址（自建填写，默认 gitlab.com）"}
      ],
      "docs": "https://github.com/zereight/gitlab-mcp"
    },
    {
